# Copy to .env and edit before `docker compose up -d --build`.

# Address other peers should dial for your P2P port.
# LAN example: 192.168.1.20   Internet example: 203.0.113.10 or p2pod.example.com
# For Docker, this is usually the Docker host's reachable IP, not a container IP.
PUBLIC_HOST=

# Port exposed to the internet by Docker/router. Usually 5000.
P2P_PORT=5000

# Port the app listens on inside the container.
P2P_LISTEN_PORT=5000

# Local-only UI port. Open http://127.0.0.1:3333.
UI_PORT=3333

# Local-only Solid-OIDC callback port for browser login.
OIDC_CALLBACK_PORT=3888

# Discovery Platform.
DISCOVERY_PORT=4000
DISCOVERY_URL=http://discovery:4000

# Optional public URL printed by discovery (e.g. https://discovery.example.com).
PUBLIC_DISCOVERY_URL=

# Optional shared secret. If set, app and discovery must use the same value.
DISCOVERY_TOKEN=

# Set to 1 only when discovery is behind a reverse proxy that adds X-Forwarded-For.
TRUST_PROXY=0