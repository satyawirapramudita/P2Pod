{
  "name": "p2pod",
  "version": "0.2.0",
  "private": true,
  "description": "P2Pod — decentralized P2P chat with Solid Pod storage (modular monorepo: discovery-platform, user-client, shared)",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:shared": "tsc -p packages/shared/tsconfig.json",
    "build:web": "npm --workspace @p2pod/web-ui run build",
    "dev:web": "npm --workspace @p2pod/web-ui run dev",
    "postinstall": "node scripts/patch-componentsjs.js && npm run build:shared",
    "patch:css": "node scripts/patch-componentsjs.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm --workspace @p2pod/web-ui run typecheck",
    "role:discovery": "ts-node packages/discovery-platform/src/index.ts",
    "role:user": "ts-node packages/user-client/src/main.ts init",
    "user": "ts-node packages/user-client/src/main.ts run",
    "user:web": "ts-node packages/user-client/src/main.ts web",
    "user:add": "ts-node packages/user-client/src/main.ts add",
    "user:switch": "ts-node packages/user-client/src/main.ts switch",
    "user:list": "ts-node packages/user-client/src/main.ts list",
    "user:connect": "ts-node packages/user-client/src/main.ts connect",
    "user:profiles": "ts-node packages/user-client/src/main.ts profiles",
    "user:edit": "ts-node packages/user-client/src/main.ts edit",
    "user:remove": "ts-node packages/user-client/src/main.ts remove",
    "discovery": "npm run role:discovery",
    "start": "ts-node packages/user-client/src/main.ts",
    "css:alice": "community-solid-server -c @css:config/file.json -f .css/alice -p 3000 -b http://localhost:3000/ --seedConfig css/seed-alice.json",
    "css:bob": "community-solid-server -c @css:config/file.json -f .css/bob -p 3001 -b http://localhost:3001/ --seedConfig css/seed-bob.json",
    "pod:login": "ts-node packages/user-client/src/main.ts pod-login",
    "pod:link": "ts-node packages/user-client/src/main.ts pod-link",
    "pod:stop": "ts-node scripts/pod-stop.ts",
    "setup:pod": "ts-node scripts/setup-pod-account.ts",
    "setup:pod:alice": "ts-node scripts/setup-pod-account.ts --css http://localhost:3000/ --email alice@example.com --password p2pod-demo-123 --pod alice --home .p2pod/alice",
    "setup:pod:bob": "ts-node scripts/setup-pod-account.ts --css http://localhost:3001/ --email bob@example.com --password p2pod-demo-123 --pod bob --home .p2pod/bob",
    "test:pod": "ts-node scripts/test-pod.ts",
    "test:local-first": "ts-node scripts/test-local-first.ts",
    "test:web-bridge": "ts-node scripts/test-web-bridge.ts",
    "test:smoke": "ts-node scripts/smoke-test.ts",
    "test:e2e": "ts-node scripts/e2e-pod-test.ts",
    "alice": "ts-node packages/user-client/src/main.ts --home .p2pod/alice --listen --port 5000 --pod http://localhost:3000/alice/ --discovery http://localhost:4000 --name alice",
    "bob": "ts-node packages/user-client/src/main.ts --home .p2pod/bob --port 5001 --pod http://localhost:3001/bob/ --discovery http://localhost:4000 --name bob --connect",
    "alice:connect": "ts-node packages/user-client/src/main.ts --home .p2pod/alice --port 5000 --pod http://localhost:3000/alice/ --discovery http://localhost:4000 --name alice --connect",
    "bob:listen": "ts-node packages/user-client/src/main.ts --home .p2pod/bob --listen --port 5001 --pod http://localhost:3001/bob/ --discovery http://localhost:4000 --name bob"
  },
  "devDependencies": {
    "@solid/community-server": "^7.3.0",
    "@types/node": "^24.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
