{
  "name": "p2pod",
  "version": "0.1.0",
  "description": "P2Pod — decentralized P2P chat with Solid Pod storage",
  "main": "dist/src/main.js",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "postinstall": "npm --prefix server/discovery-server install",
    "start": "ts-node src/main.ts",
    "discovery": "npm --prefix server/discovery-server run dev",
    "css:alice": "community-solid-server -c @css:config/file.json -f .css/alice -p 3000 -b http://localhost:3000/ --seedConfig css/seed-alice.json",
    "css:bob": "community-solid-server -c @css:config/file.json -f .css/bob -p 3001 -b http://localhost:3001/ --seedConfig css/seed-bob.json",
    "setup:pod": "ts-node scripts/setup-pod-account.ts",
    "test:pod": "ts-node scripts/test-pod.ts",
    "test:smoke": "ts-node scripts/smoke-test.ts",
    "test:e2e": "ts-node scripts/e2e-pod-test.ts",
    "alice": "ts-node src/main.ts --home .p2pod/alice --listen --port 5000 --pod http://localhost:3000/alice/ --discovery http://localhost:4000 --name alice",
    "bob": "ts-node src/main.ts --home .p2pod/bob --port 5001 --pod http://localhost:3001/bob/ --discovery http://localhost:4000 --name bob --connect",
    "alice:connect": "ts-node src/main.ts --home .p2pod/alice --port 5000 --pod http://localhost:3000/alice/ --discovery http://localhost:4000 --name alice --connect",
    "bob:listen": "ts-node src/main.ts --home .p2pod/bob --listen --port 5001 --pod http://localhost:3001/bob/ --discovery http://localhost:4000 --name bob"
  },
  "dependencies": {
    "@inrupt/solid-client": "^4.0.0",
    "@inrupt/solid-client-authn-node": "^5.0.3",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@solid/community-server": "^7.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
